{
  "name": "bot1",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "npx migrate-mongo up && node server.js",
    "eslint": "npx eslint .",
    "docker:local": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build",
    "docker:local:stop": "docker compose -f docker-compose.yml -f docker-compose.local.yml stop",
    "docker:prod": "docker compose up -d --build",
    "docker:prod:stop": "docker compose stop",
    "docker:prod:update": "docker exec discord-bot sh -c \"git pull && npm install --omit=dev\"",
	"docker:prod:restart": "docker compose restart"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "canvas": "^2.11.2",
    "discord.js": "14.25.1",
    "dotenv": "^16.5.0",
    "emoji-regex": "^10.3.0",
    "jsdom": "^24.1.0",
    "migrate-mongo": "^12.1.3",
    "mongoose": "^8.1.0",
    "node-fetch": "2.7.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "globals": "^15.0.0",
    "nodemon": "^3.0.3"
  }
}
